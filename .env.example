Saylo — Monorepo Root Environment Configuration Template (.env.example)
# This template documents all environment variables used across the Saylo monorepo.
#
# LOCAL DEVELOPMENT SETUP:
# Each subservice maintains its own .env file:
#   1. backend/.env                  (Gateway API & Durable Background Worker)
#   2. frontend/.env.local (or .env) (Next.js Web Application)
#   3. services/analysis-service/.env(LangGraph ML Inference Microservice)
#
# Alternatively, in local development, services/analysis-service will automatically
# fall back to reading variables from backend/.env or the root .env if present.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GATEWAY BACKEND & WORKER (used by backend/main.py, worker.py, db.py)
# ------------------------------------------------------------------------------
# Port for the FastAPI gateway server (default: 5000)
PORT=5000

# Server logging level (debug | info | warn | error)
LOG_LEVEL=info

# Node/runtime environment (development | production).
# In production, SQLite fallback is disallowed and PostgreSQL is enforced.
NODE_ENV=development

# Allowed CORS origins (comma-separated list for frontend access)
ALLOWED_ORIGINS=http://localhost:3000

# Supabase Project Base URL (used for JWT JWKS validation and Storage API)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase Secret / Service Role Key (SERVER-SIDE ONLY - NEVER EXPOSE TO FRONTEND)
# Used by backend/services/storage.py for private audio bucket uploads/downloads.
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_OR_SERVICE_ROLE_KEY

# PostgreSQL Database Connection URL
# For Supabase, use the Session Pooler URI (port 5432). URL-encode any special characters in password.
# Format: postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:5432/postgres
# Local fallback (development only): sqlite+aiosqlite:///./dev.db
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.co:5432/postgres

# Database SSL verification mode (verify-full | disable)
# 'disable' is strictly restricted to local loopback (localhost/127.0.0.1) test databases.
DATABASE_SSL=verify-full

# Path to the Supabase Root CA certificate (required on Windows/environments missing Supabase CA)
# Optional if system CA store trusts Supabase. Example: C:/path/to/saylo/backend/supabase-ca.crt
DATABASE_SSL_CA_FILE=

# Database connection pool settings (optional overrides)
DATABASE_POOL_SIZE=2
DATABASE_MAX_OVERFLOW=0

# Google Gemini API Key (used for Gemini Live real-time audio sessions)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Gemini Live bidirectional model name
GEMINI_LIVE_MODEL=gemini-3.8-live

# Internal URL of the Analysis microservice
ANALYSIS_SERVICE_URL=http://127.0.0.1:8000

# Shared secret bearer token between Gateway and Analysis Microservice
# Must be at least 32 characters. Must match ANALYSIS_SERVICE_TOKEN in analysis-service/.env.
ANALYSIS_SERVICE_TOKEN=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Gateway session rate & safety limits (optional)
MAX_SESSION_SECONDS=900
DAILY_SESSION_LIMIT=5
MAX_LIVE_CONNECTIONS=4
STALE_QUEUED_SECONDS=1200


# ------------------------------------------------------------------------------
# 2. ANALYSIS MICROSERVICE (used by services/analysis-service/app.py)
# ------------------------------------------------------------------------------
# Shared secret bearer token matching the Gateway token above (required)
# ANALYSIS_SERVICE_TOKEN=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Google Gemini API key (used by modules/insights.py for AI coach feedback generation)
# GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Model used for generating coaching insights
GEMINI_INSIGHT_MODEL=gemini-2.5-flash

# Analysis request timeout in seconds (optional, default: 90)
ANALYSIS_TIMEOUT_S=90

# Optional custom path to fine-tuned STAR answer classifier model directory
STAR_MODEL_PATH=


# ------------------------------------------------------------------------------
# 3. FRONTEND WEB APPLICATION (used by frontend Next.js)
# Note: Next.js only exposes variables prefixed with NEXT_PUBLIC_ to the browser.
# ------------------------------------------------------------------------------
# Base HTTP URL for the Saylo backend API gateway
NEXT_PUBLIC_API_BASE=http://localhost:5000

# Supabase Project URL for client-side Auth SDK
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase Publishable / Anon Key (PUBLIC SAFE KEY ONLY - NEVER PUT SECRET KEY HERE)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_ANON_KEY

# Enable GitHub OAuth button on login page (requires configuring GitHub provider in Supabase)
NEXT_PUBLIC_SUPABASE_GITHUB_ENABLED=false

