# ==============================================================================
# Saylo — Analysis Microservice Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to services/analysis-service/.env
# Note: For local development, this service can also read backend/.env or root .env
# ==============================================================================

# Shared secret bearer token (must match ANALYSIS_SERVICE_TOKEN in backend/.env)
ANALYSIS_SERVICE_TOKEN=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Google Gemini API key (used by modules/insights.py for AI coach report generation)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Gemini model used for generating coaching insights
GEMINI_INSIGHT_MODEL=gemini-2.5-flash

# Analysis request timeout in seconds (optional, default: 90)
ANALYSIS_TIMEOUT_S=90

# CORS allowed origins (comma-separated, default: http://localhost:3000,http://localhost:5000)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000

# Optional custom path to fine-tuned STAR answer classifier model directory
STAR_MODEL_PATH=
