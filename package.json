{
  "name": "speakez",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:clean": "npx kill-port 3000 5000 8000 || exit 0",
    "dev:clean:ps": "powershell -NoProfile -Command \"try{npx kill-port 3000 5000 8000}catch{}\"",
    "dev:all": "npm-run-all -s dev:clean dev",
    "dev": "npm-run-all -p dev:api dev:web",
    "dev:api": "npm --workspace apps/api run dev",
    "dev:web": "npm --workspace apps/web run dev",
    "build": "npm-run-all -s build:api build:web",
    "build:api": "npm --workspace apps/api run build",
    "build:web": "npm --workspace apps/web run build",
    "lint": "npm-run-all -s lint:api lint:web",
    "lint:api": "npm --workspace apps/api run lint",
    "lint:web": "npm --workspace apps/web run lint"
  },
  "devDependencies": {
    "kill-port": "^2.0.1",
    "npm-run-all": "^4.1.5"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
