# Copy these entries into backend/.env, preserving your existing Gemini settings.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Copy the Session pooler (:5432) URI from Supabase Connect. URL-encode the password.
DATABASE_URL=postgresql+asyncpg://postgres.YOUR_PROJECT_REF:YOUR_ENCODED_PASSWORD@YOUR_POOLER_HOST:5432/postgres
DATABASE_SSL=verify-full
# Only if certificate verification requires the downloaded Supabase CA:
# DATABASE_SSL_CA_FILE=C:/path/to/supabase-ca.crt
ALLOWED_ORIGINS=http://localhost:3000
GEMINI_API_KEY=YOUR_EXISTING_GEMINI_KEY
GEMINI_LIVE_MODEL=gemini-3.8-live
ANALYSIS_SERVICE_URL=http://127.0.0.1:8000
# Generate locally; use the same value in the analysis service. At least 32 characters.
ANALYSIS_SERVICE_TOKEN=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
NODE_ENV=development
LOG_LEVEL=info
