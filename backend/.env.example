# Saylo — Backend & Worker Environment Configuration Template (.env.example)
# Copy this file to backend/.env and replace placeholders with your credentials.

# Server configuration
PORT=5000
LOG_LEVEL=info
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000

# Supabase Auth & Storage configuration
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Server-side only; NEVER expose to frontend. Used for private audio storage bucket access.
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_OR_SERVICE_ROLE_KEY

# PostgreSQL Database Connection URL (Session pooler on port 5432)
# Local fallback (dev only): sqlite+aiosqlite:///./dev.db
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.co:5432/postgres
DATABASE_SSL=verify-full
# Path to root CA certificate if needed on Windows/environments without Supabase CA in trust store
# DATABASE_SSL_CA_FILE=C:/path/to/saylo/backend/supabase-ca.crt
# Optional pool overrides:
DATABASE_POOL_SIZE=2
DATABASE_MAX_OVERFLOW=0

# Gemini API configuration for real-time live sessions
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_LIVE_MODEL=gemini-3.8-live

# Analysis Microservice inter-service communication
ANALYSIS_SERVICE_URL=http://127.0.0.1:8000
# Shared secret token (at least 32 characters; must match analysis-service token)
ANALYSIS_SERVICE_TOKEN=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Session & safety limits (optional overrides)
MAX_SESSION_SECONDS=900
DAILY_SESSION_LIMIT=5
MAX_LIVE_CONNECTIONS=4
STALE_QUEUED_SECONDS=1200
