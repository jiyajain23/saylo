# Saylo — Frontend Web Application Environment Configuration Template (.env.example)
# Copy this file to frontend/.env.local (recommended by Next.js) or frontend/.env

# Backend Gateway API base URL
NEXT_PUBLIC_API_BASE=http://localhost:5000
# Supabase Project Base URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Supabase Publishable / Anon Key (PUBLIC SAFE KEY ONLY - NEVER PUT SECRET KEY HERE)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_ANON_KEY
# Optional GitHub OAuth sign-in toggle (requires configuring GitHub provider in Supabase)
NEXT_PUBLIC_SUPABASE_GITHUB_ENABLED=false
