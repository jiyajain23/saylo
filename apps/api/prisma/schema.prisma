generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum SessionScenario {
  INTERVIEW
  PITCH
  MEETING
}

enum SessionStatus {
  LIVE
  ENDED
  ANALYZING
  READY
  FAILED
}

model User {
  id        String    @id @default(cuid())
  email     String?   @unique
  name      String?
  createdAt DateTime  @default(now())
  sessions  Session[]
}

model Session {
  id            String            @id @default(cuid())
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  status        SessionStatus     @default(LIVE)
  scenario      SessionScenario   @default(INTERVIEW)
  title         String?

  persona       String            @default("DEFAULT")
  pressureLevel Int               @default(0)

  userId        String?
  user          User?             @relation(fields: [userId], references: [id])

  contextRaw    String?
  contextJson   Json?

  segments      TranscriptSegment[]
  analysis      AnalysisResult?
}

model TranscriptSegment {
  id        String   @id @default(cuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  speaker   String   // "user" | "ai"
  text      String
}

model AnalysisResult {
  id             String   @id @default(cuid())
  sessionId      String   @unique
  session        Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  createdAt      DateTime @default(now())
  speechMetrics  Json?
  nlpMetrics     Json?
  alignment      Json?
  confidence     Float?
  highlights     Json?
  strengths      Json?
  weaknesses     Json?
  suggestions    Json?
}
